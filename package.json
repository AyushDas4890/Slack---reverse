{
  "name": "relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Relay: a Slack-style team chat rebuilt from public product behavior, every premium feature unlocked.",
  "scripts": {
    "dev": "node server/index.ts & vite",
    "dev:server": "node server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --test server/slash.test.ts src/premium.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
